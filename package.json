{
  "_meta": {
    "header": [
      "Defines the Buzzword Bingo scripts and pinned dependencies.",
      "Keeps homepage collection reproducible on Node and TypeScript."
    ],
    "schemaVersion": 1
  },
  "name": "buzzword-bingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "companies": "tsx scripts/companies.ts",
    "cohort:established": "tsx scripts/established-cohort.ts",
    "crawl": "tsx scripts/crawl.ts",
    "sample": "tsx scripts/sample.ts",
    "tuning:sample": "tsx scripts/tuning-sample.ts",
    "report": "tsx scripts/report.ts",
    "score": "tsx scripts/score.ts",
    "compare": "tsx scripts/compare.ts",
    "report:phase2": "tsx scripts/report-phase2.ts",
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "build": "tsx scripts/prepare-site.ts && tsx scripts/og.ts && astro build",
    "check": "tsc --noEmit && astro check",
    "test": "tsx --test tests/*.test.ts",
    "verify:site": "tsx scripts/verify-site.ts",
    "refresh": "tsx scripts/refresh.ts",
    "report:phase4": "tsx scripts/report-phase4.ts",
    "verify:public": "tsx scripts/verify-public.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.10",
    "context.dev": "3.28.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "satori": "0.63.2",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "node": "22.23.4",
    "prettier": "3.10.0",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "volta": {
    "node": "22.23.4"
  },
  "overrides": {
    "fflate": "0.8.3"
  }
}
