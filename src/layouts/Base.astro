---
// Provides accessible navigation, provisional labels, sharing metadata, and the satire footer.
// Gives every static page a consistent frame and a clear route to methodology and opt-out.
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow-condensed/800.css";
import "@fontsource/public-sans/400.css";
import "@fontsource/public-sans/500.css";
import "@fontsource/public-sans/600.css";
import "@fontsource/public-sans/700.css";
import "../styles/global.css";
import { siteData, sitePath } from "../site-data.js";
const data = await siteData();
interface Props {
  title?: string;
  description?: string;
  og?: string;
}
const {
  title = "Buzzword Bingo — the buzzwords have gone public",
  description = "A lovingly unserious comparison of startup and public-cloud homepage language. Real counts, fixed rules, public homepage text.",
  og = "og/comparison.png",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin)
  .href;
const image = new URL(sitePath(og), Astro.site || Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f5ec" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={sitePath("favicon.svg")} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Buzzword Bingo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="masthead shell">
      <a class="wordmark" href={sitePath("")} aria-label="Buzzword Bingo home">
        <span class="brand-ball">B</span>
        <span>
          BUZZWORD<span class="wordmark-second">BINGO</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href={sitePath("#leaderboard")}>The rankings</a>
        <a href={sitePath("play/")}>Play bingo</a>
        <a href={sitePath("about/")}>The fine print</a>
      </nav>
      <span class="preview-pill">
        {data.config.provisional
          ? "Provisional sample"
          : "Full YC batch snapshot"}
      </span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="footer-brand" href={sitePath("")}>
          Buzzword Bingo.
        </a>
        <p>This is satire, made with love.</p>
      </div>
      <div class="footer-note">
        <p>We count the language. You judge the pitch.</p>
        <p>
          {data.config.provisional
            ? "Provisional sample results."
            : "Full eligible YC batch; systematic public-cloud sample. Captures can age."}
        </p>
      </div>
      <div class="footer-links">
        <a href={sitePath("about/")}>Methodology & sources</a>
        <a href={sitePath("opt-out/")}>Opt out a company</a>
        <span>{data.week}</span>
      </div>
    </footer>
  </body>
</html>
